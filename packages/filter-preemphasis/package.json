{
  "name": "@audio/filter-preemphasis",
  "version": "1.1.3",
  "description": "Pre-emphasis / de-emphasis filter",
  "type": "module",
  "sideEffects": false,
  "main": "pre-emphasis.js",
  "types": "./pre-emphasis.d.ts",
  "exports": {
    ".": {
      "types": "./pre-emphasis.d.ts",
      "default": "./pre-emphasis.js"
    },
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "pre-emphasis.js",
    "pre-emphasis.d.ts",
    "audio.js",
    "audio.d.ts"
  ],
  "keywords": [
    "audio",
    "dsp",
    "filter",
    "preemphasis"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/filter.git",
    "directory": "packages/filter-preemphasis"
  },
  "homepage": "https://github.com/audiojs/filter/tree/main/packages/filter-preemphasis",
  "bugs": {
    "url": "https://github.com/audiojs/filter/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "audio": "./audio.js",
  "funding": "https://github.com/sponsors/audiojs"
}
