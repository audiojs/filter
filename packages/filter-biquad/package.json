{
  "name": "@audio/filter-biquad",
  "version": "2.0.1",
  "description": "Audio-facing biquad filters — highpass, lowpass, bandpass, notch, allpass (Hz/Q params, per-channel state)",
  "type": "module",
  "sideEffects": false,
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./highpass": "./highpass.js",
    "./lowpass": "./lowpass.js",
    "./bandpass": "./bandpass.js",
    "./notch": "./notch.js",
    "./allpass": "./allpass.js",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "highpass.js",
    "lowpass.js",
    "bandpass.js",
    "notch.js",
    "allpass.js",
    "audio.js",
    "audio.d.ts"
  ],
  "dependencies": {
    "@audio/biquad": "^1.1.0"
  },
  "keywords": [
    "audio",
    "dsp",
    "filter",
    "biquad",
    "highpass",
    "lowpass",
    "bandpass",
    "notch",
    "allpass"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/filter.git",
    "directory": "packages/filter-biquad"
  },
  "homepage": "https://github.com/audiojs/filter/tree/main/packages/filter-biquad",
  "bugs": {
    "url": "https://github.com/audiojs/filter/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "audio": "./audio.js",
  "funding": "https://github.com/sponsors/audiojs"
}
