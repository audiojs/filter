{
  "name": "@audio/filter",
  "version": "3.0.0",
  "type": "module",
  "sideEffects": false,
  "description": "Audio filters – weighting, auditory, analog, speech, eq, effects",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./weighting": {
      "types": "./weighting/index.d.ts",
      "default": "./weighting/index.js"
    },
    "./weighting/*.js": "./weighting/*.js",
    "./auditory": {
      "types": "./auditory/index.d.ts",
      "default": "./auditory/index.js"
    },
    "./auditory/*.js": "./auditory/*.js",
    "./analog": {
      "types": "./analog/index.d.ts",
      "default": "./analog/index.js"
    },
    "./analog/*.js": "./analog/*.js",
    "./speech": {
      "types": "./speech/index.d.ts",
      "default": "./speech/index.js"
    },
    "./speech/*.js": "./speech/*.js",
    "./eq": {
      "types": "./eq/index.d.ts",
      "default": "./eq/index.js"
    },
    "./eq/*.js": "./eq/*.js",
    "./effect": {
      "types": "./effect/index.d.ts",
      "default": "./effect/index.js"
    },
    "./effect/*.js": "./effect/*.js"
  },
  "types": "./index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test.js",
    "test:types": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext test/types.ts",
    "test:readme": "node test/readme.js",
    "test:all": "npm test && npm run test:types && npm run test:readme",
    "plot": "node plot/generate.js"
  },
  "files": [
    "weighting",
    "auditory",
    "analog",
    "speech",
    "eq",
    "effect",
    "index.js",
    "index.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/audio-filter.git"
  },
  "bugs": {
    "url": "https://github.com/audiojs/audio-filter/issues"
  },
  "homepage": "https://github.com/audiojs/audio-filter#readme",
  "keywords": [
    "audio",
    "dsp",
    "filter",
    "a-weighting",
    "c-weighting",
    "k-weighting",
    "itu-468",
    "riaa",
    "equalizer",
    "parametric-eq",
    "graphic-eq",
    "crossover",
    "crossfeed",
    "moog",
    "korg",
    "diode-ladder",
    "vocoder",
    "formant",
    "gammatone",
    "bark",
    "erb",
    "octave-band",
    "psychoacoustics",
    "signal-processing"
  ],
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "digital-filter": "^2.0.0"
  },
  "devDependencies": {
    "tst": "^9.4.0",
    "typescript": "^5.8.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "access": "public"
  }
}
